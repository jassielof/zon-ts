{
  "tasks": {
    "pack": "deno run --allow-all scripts/node.ts",
    "test": "deno test --allow-read",
    "check": "deno check src/mod.ts && deno lint"
  },
  "exclude": ["references/", "node/"],
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.43.2",
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "publish": {
    "exclude": ["tests/**", "src/**/*.test.ts"]
  },
  "exports": {
    ".": "./src/mod.ts",
    "./types": "./src/types.ts",
    "./parse": "./src/parse.ts",
    "./stringify": "./src/stringify.ts"
  },
  "license": "MPL-2.0",
  "name": "@jassielof/zon",
  "version": "0.1.0"
}
