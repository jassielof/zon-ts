{
  "name": "@jassiel/zon",
  "version": "0.1.0-rc.1",
  "license": "MPL-2.0",
  "tasks": {
    "pack": {
      "command": "deno run --allow-all scripts/node.ts",
      "description": "Pack the library for Node",
      "files": [
        "scripts/node.ts"
      ],
      "output": [
        "node/**/*"
      ]
    },
    "check": {
      "description": "Check types",
      "command": "deno check --doc src tests scripts",
      "files": [
        "src/**/*",
        "tests/**/*",
        "scripts/**/*"
      ]
    },
    "quality": {
      "description": "Run static analysis quality checks",
      "command": "deno fmt --check",
      "files": [
        "**/*"
      ],
      "dependencies": [
        "lint"
      ]
    },
    "lint": {
      "description": "Lint code and documentation",
      "command": "deno lint",
      "dependencies": [
        "check",
        "lint-doc"
      ],
      "files": [
        "src/**/*",
        "tests/**/*",
        "scripts/**/*"
      ]
    },
    "lint-doc": {
      "description": "Lint documentation",
      "command": "deno doc --lint src",
      "files": [
        "src/**/*"
      ]
    },
    "test": {
      "command": "deno test --permission-set --doc --parallel",
      "description": "Test code and documentation examples",
      "files": [
        "**/*.test.ts"
      ]
    },
    "test:node": {
      "description": "Run compatibility tests with Node.js",
      "command": "node --test tests/compat/node.test.cjs tests/compat/node.test.mjs",
      "dependencies": [
        "pack"
      ],
      "files": [
        "tests/compat/node.test.*"
      ]
    },
    "test:bun": {
      "description": "Run compatibility tests with Bun",
      "command": "bun test tests/compat/bun.test.ts",
      "dependencies": [
        "pack"
      ],
      "files": [
        "tests/compat/bun.test.*"
      ]
    },
    "test:compat": {
      "description": "Run Node.js and Bun compatibility tests",
      "dependencies": [
        "test:node",
        "test:bun"
      ]
    }
  },
  "test": {
    "permissions": {
      "read": true
    }
  },
  "exclude": [
    "references/",
    "node/",
    "tests/compat/"
  ],
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.43.2",
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "publish": {
    "include": [
      "LICENSE.txt",
      "README.md",
      "deno.json",
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*.test.ts"
    ]
  },
  "exports": {
    ".": "./src/mod.ts",
    "./types": "./src/types.ts",
    "./parse": "./src/parse.ts",
    "./stringify": "./src/stringify.ts"
  }
}
